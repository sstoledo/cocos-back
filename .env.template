DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cocos?schema=public
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_DISABLE_ORIGIN_CHECK=true
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
FRONTEND_URL=http://localhost:5173
PORT=4000

GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OCR extraction model only; unlike embeddings, it has no stored-vector coupling.
GEMINI_OCR_MODEL=gemini-3.8-flash
# Max seconds-ish window (ms) for one OCR request before it aborts; a hung
# provider must not hold the upload response.
GEMINI_OCR_TIMEOUT_MS=60000
APIPERU_TOKEN=

# SUNAT CPE emission (SEE directo). Beta URL by default; switch to
# https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService for production.
SUNAT_BILL_SERVICE_URL=https://e-factura-test.sunat.gob.pe/ol-ti-itcpfegem/billService
# SOL credentials: RUC + user code, e.g. RUC20131312955MODDATOS
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
# Digital certificate as PEM (convert the SUNAT .pfx with openssl)
SUNAT_CERT_PATH=
SUNAT_CERT_KEY_PATH=
# Only needed if the private key file is passphrase-protected
SUNAT_CERT_PASSWORD=
